# API Configuration
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=Music Streaming Platform
VITE_APP_VERSION=1.0.0

# Development Mode (skip authentication for UI testing)
# Set VITE_DEV_MODE=true to bypass authentication
# Set VITE_DEV_USER_TYPE=creator or subscriber to test different views
VITE_DEV_MODE=false
VITE_DEV_USER_TYPE=creator
