// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Users Domain
// ============================================

enum UserType {
  creator
  subscriber
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  userType     UserType
  displayName  String
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)

  // Relations
  creatorProfile     CreatorProfile?
  subscriberProfile  SubscriberProfile?
  createdContent     Content[]          @relation("CreatorContent")
  createdPlaylists   Playlist[]         @relation("CreatorPlaylists")
  accessCodesCreated AccessCode[]       @relation("CreatorAccessCodes")
  accessCodesRedeemed AccessCode[]      @relation("RedeemedAccessCodes")
  accessGrantsAsSubscriber AccessGrant[] @relation("SubscriberGrants")
  accessGrantsAsCreator    AccessGrant[] @relation("CreatorGrants")
  accessGrantsRevoked      AccessGrant[] @relation("RevokedByUser")
  streamSessions     StreamSession[]
  liveStreams        LiveStream[]       @relation("CreatorLiveStreams")
  streamViewers      StreamViewer[]     @relation("StreamViewers")
  subscriptionPlans  SubscriptionPlan[] @relation("CreatorPlans")

  @@index([email])
  @@index([userType])
  @@map("users")
}

model CreatorProfile {
  userId          String   @id
  genres          String[] @default([])
  subscriberCount Int      @default(0)
  totalStreams    Int      @default(0)
  totalRevenue    Float    @default(0)
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model SubscriberProfile {
  userId           String   @id
  activeAccessCount Int     @default(0)
  totalStreams     Int      @default(0)
  updatedAt        DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriber_profiles")
}

// ============================================
// Content Domain
// ============================================

model Content {
  id              String   @id @default(uuid())
  creatorId       String
  title           String
  description     String?
  genre           String
  duration        Int
  coverArtUrl     String?
  tags            String[] @default([])
  fileStoragePath String
  streamUrl       String
  uploadedAt      DateTime @default(now())
  playCount       Int      @default(0)
  isActive        Boolean  @default(true)

  // Relations
  creator          User              @relation("CreatorContent", fields: [creatorId], references: [id], onDelete: Cascade)
  playlistContent  PlaylistContent[]
  streamSessions   StreamSession[]

  @@index([creatorId])
  @@index([genre])
  @@index([isActive])
  @@map("content")
}

model Playlist {
  id          String   @id @default(uuid())
  creatorId   String
  name        String
  description String?
  coverArtUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  creator         User              @relation("CreatorPlaylists", fields: [creatorId], references: [id], onDelete: Cascade)
  playlistContent PlaylistContent[]

  @@index([creatorId])
  @@map("playlists")
}

model PlaylistContent {
  playlistId String
  contentId  String
  position   Int
  addedAt    DateTime @default(now())

  // Relations
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([playlistId, contentId])
  @@map("playlist_content")
}

// ============================================
// Access Control Domain
// ============================================

model AccessCode {
  code         String    @id
  creatorId    String
  paymentId    String    @unique
  amount       Float
  currency     String
  durationDays Int
  expiresAt    DateTime?
  isRedeemed   Boolean   @default(false)
  redeemedBy   String?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
  isValid      Boolean   @default(true)

  // Relations
  creator      User          @relation("CreatorAccessCodes", fields: [creatorId], references: [id], onDelete: Cascade)
  redeemer     User?         @relation("RedeemedAccessCodes", fields: [redeemedBy], references: [id], onDelete: SetNull)
  accessGrants AccessGrant[]

  @@index([creatorId])
  @@index([paymentId])
  @@map("access_codes")
}

model AccessGrant {
  id           String    @id @default(uuid())
  subscriberId String
  creatorId    String
  accessCode   String
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  revokedBy    String?

  // Relations
  subscriber User       @relation("SubscriberGrants", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    User       @relation("CreatorGrants", fields: [creatorId], references: [id], onDelete: Cascade)
  code       AccessCode @relation(fields: [accessCode], references: [code], onDelete: Cascade)
  revoker    User?      @relation("RevokedByUser", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([subscriberId])
  @@index([creatorId])
  @@index([subscriberId, creatorId, isActive])
  @@map("access_grants")
}

// ============================================
// Streaming Domain
// ============================================

model StreamSession {
  id                   String    @id @default(uuid())
  subscriberId         String
  contentId            String
  creatorId            String
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  duration             Int       @default(0)
  bytesTransferred     BigInt    @default(0)
  completionPercentage Int       @default(0)

  // Relations
  subscriber User    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  content    Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([contentId])
  @@index([creatorId])
  @@index([startedAt])
  @@map("stream_sessions")
}

// ============================================
// Live Streaming Domain
// ============================================

enum LiveStreamStatus {
  scheduled
  live
  ended
  cancelled
}

model LiveStream {
  id               String           @id @default(uuid())
  creatorId        String
  title            String
  description      String?
  scheduledFor     DateTime?
  status           LiveStreamStatus @default(scheduled)
  streamKey        String           @unique
  rtmpUrl          String
  playbackUrl      String
  viewerCount      Int              @default(0)
  maxViewers       Int              @default(0)
  startedAt        DateTime?
  endedAt          DateTime?
  duration         Int              @default(0)
  recordingEnabled Boolean          @default(false)
  recordingUrl     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  creator User           @relation("CreatorLiveStreams", fields: [creatorId], references: [id], onDelete: Cascade)
  viewers StreamViewer[]

  @@index([creatorId])
  @@index([status])
  @@index([scheduledFor])
  @@index([startedAt])
  @@map("live_streams")
}

model StreamViewer {
  id           String    @id @default(uuid())
  streamId     String
  subscriberId String
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  watchTime    Int       @default(0)

  // Relations
  stream     LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  subscriber User       @relation("StreamViewers", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([subscriberId])
  @@index([streamId, subscriberId])
  @@map("stream_viewers")
}


// Subscription Plans
model SubscriptionPlan {
  id             String   @id @default(uuid())
  creatorId      String
  name           String
  description    String
  amount         Int      // Amount in cents
  currency       String   @default("USD")
  durationDays   Int      @default(30)
  stripePriceId  String?  // Stripe Price ID
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  creator        User     @relation("CreatorPlans", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([isActive])
}
